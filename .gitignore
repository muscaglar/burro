# Xcode and Swift
# apps/ios depends on no package, so there is no Package.resolved to commit.
# What a build leaves in apps/ios/build is covered by build/ above.
DerivedData/
*.xcuserstate
xcuserdata/
*.xcodeproj/project.xcworkspace/
*.xcresult
.build/
.swiftpm/
Package.resolved

# Data: releases and downloads live in object storage, never in git
data/raw/
data/releases/
*.parquet
*.npy
*.pmtiles
!data/fixtures/**

# Tools and OS
.DS_Store
.claude/*
!.claude/skills/
